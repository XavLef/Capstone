# Between variance = a --> Variance of hypothetical means (VHM) Var(E[S|Theta])
# Within variance = s^2 --> Expected process variance (EPV) E[Var(S|Theta)]
# d'où Var(S) = s^2 + a
k = summary(fit)[["unbiased"]][2] / summary(fit)[["unbiased"]][1] # k = s^2 / a
5 / (5 + K)
