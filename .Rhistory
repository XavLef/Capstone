knitr::opts_chunk$set(echo = TRUE, message=FALSE)
sin <- readRDS("donnees_sinistres.rds")
# 2 pts pour visualiser la structure avec str ou summary
str(sin)
summary(sin)
# 1.5 pts pour la conversation de HauteurEau en numeric
sin$HauteurEau <- as.numeric(sin$HauteurEau)
# 2 pts pour la correction des NAs.
sin$HauteurEau[sin$HauteurEau == -999] <- NA
# 4 pts pour le graphique (title, axes, couleur, allure générale)
# 1 pts pour interprétation : Coût augmente avec hauteur d'eau. Coût plus grand si sous-sol. Hauteur d'eau plus grande si pas de sous-sol.
library(ggplot2)
ggplot(sin, aes(x = HauteurEau, y = Cout/10^3, col = SousSol)) +
geom_point() +
labs(y = "Coût (k$)", x = "Hauteur d'eau (M)", col = "Présence d'un sous-sol:") +
ggtitle("Coûts des sinistres inondations en fonction \ndu niveau d'eau et la présence d'un sous-sol") +
theme_bw()
# 3 pts pour la correction.
sin$SousSol <- factor(sin$SousSol, levels = c("Oui", "Non"))
# [Option #1] 3 pts : Graphique de type box-plot
ggplot(sin, aes(x = SousSol, y = Cout/10^3)) +
geom_boxplot() +
labs(y = "Coût des sinistres (k$)", x = "Présence d'une sous-sol") +
ggtitle("Coût des sinistres en fonction de la présence d'un sous-sol") +
theme_bw()
# [Option #2] 3 pts : Histogramme ou density
ggplot(sin, aes(fill = SousSol, x = Cout)) +
geom_density(alpha = 0.8, col = NA) +
labs(x = "Coût des sinistres (k$)", y = "Densité", fill = "Présence d'un sous-sol:") +
ggtitle("Coût des sinistres en fonction de la présence d'un sous-sol") +
theme_bw()
# 0.5 pts : Interprétation graphique : Les coûts sont plus élevés s'il y a un sous-sol
# 0.5 pts : Interprétation statistique : On compare la moyenne avec t.test.
t.test(sin$Cout[sin$SousSol == "Oui"], sin$Cout[sin$SousSol == "Non"], var.equal = FALSE)
# La pvalue est 0.04, donc les moyennes de sont pas identiques à un seuil de 5%.
# 1.5 pts pour la valeur.
# 1.5 pts pour "Sans biais si la non-réponse est MCAR."
mean(sin$Hauteur, na.rm = TRUE)
# Extraction des NAs.
missing <- is.na(sin$HauteurEau)
# 0 pts. Intuition : Comparison des moyennes des coûts.
mean(sin$Cout[missing]); mean(sin$Cout[!missing])
# 2 pts : Test t de moyennes identiques avec Coûts.
# p-value de 0.0007, on rejette H0, donc les moyennes de sont pas les mêmes.
t.test(sin$Cout[missing], sin$Cout[!missing], var.equal = FALSE)
# Intuition : Comparaison des % de sous-sol.
round(prop.table(table(sin$SousSol, missing), 2), 2)
# 2 pts : Test Chi2 avec SousSol.
# p-value de 0.8873, on ne rejette pas H0, donc les proportions de sous-sol ne dépendent pas des données manquantes.
chisq.test(sin$SousSol, missing, correct=FALSE)
# 1pts : Interprétation.
# Comme H depend de C, mais pas de SS, le patron de réponse de peut pas être MCAR.
# 3pts : Faire l'imputation
# Méthode manuelle.
mod <- glm(HauteurEau ~ Cout + SousSol , data = sin)
sin$HauteurEauImp1 <- NA
predict(mod, newdata = sin[missing, ], type = "response")
sin$HauteurEauImp1[missing]
# 3pts : Faire l'imputation
# Méthode manuelle.
mod <- glm(HauteurEau ~ Cout + SousSol , data = sin)
sin$HauteurEauImp1 <- NA
sin$HauteurEauImp1[missing] <- predict(mod, newdata = sin[missing, ], type = "response")
# Méthode avec MICE.
# À FAIRE.
# 0.5 pts : Moyenne après imputation.
mean(c(na.omit(sin$HauteurEau), na.omit(sin$HauteurEauImp1)))
# 0.5 pts : Interprétation - La moyenne est un peu plus grande, ce qui est attendu car les coûts étaient plus grands lorsque les données étaient manquantes.
