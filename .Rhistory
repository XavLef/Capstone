# Q10.a -> Gnération de données pour 3 classes de 20 observations et 50 variables
set.seed(8)
classe_1 = matrix(rnorm(20*50, mean = 0.3), nrow = 20)
classe_2 = matrix(rnorm(20*50, mean = 0.7), nrow = 20)
classe_3 = matrix(rnorm(20*50, mean = 1.2), nrow = 20)
X <- rbind(classe_1, classe_2, classe_3)
# Q10.b -> PCA sur les 60 observations
PCA <- prcomp(X, scale = TRUE)
couleur <- c(rep("red", 20), rep("blue", 20), rep("green", 20))
plot(PCA$x[, 1], PCA$x[, 2],
col = couleur,
pch = 19,
xlab = "CP1",
ylab = "P2",
main = "Analyse en Composantes Principales")
legend("topright",
c("Classe 1", "Classe 2", "Classe 3"),
col = c("red", "blue", "green"),
pch = 19,
bty = "n")
summary(PCA)
#Q10.c
# K-means cluster sur les onservations avec k=3
set.seed(8)
resultat <- kmeans(X, centers = 3)
label <- c(rep(1, 20), rep(2, 20), rep(3, 20))
comparaiton <- table(resultat$cluster, label)
print(comparaiton)
# Lignes: clusters du k-Means
# Colonnes: les étiquettes
# Le cluster 1 contient la classe 2 et 3: 6 et 8
# Le cluster 2 contient surtout la classe 1: 20
# Le cluster 3 contient surtout la classe 3: 12
# Donc l'assignation: cluster 1: classe 2, cluster 2: classe 1, cluster 3: classe 3
# Accuracy: (6 + 20 + 12) / 60 = 63.33%
#Q10.d
# K-means cluster sur les onservations avec k=2
set.seed(8)
resultat <- kmeans(X, centers = 2)
label <- c(rep(1, 20), rep(2, 20), rep(3, 20))
comparaiton <- table(resultat$cluster, label)
print(comparaiton)
# Lignes: clusters du k-Means
# Colonnes: les étiquettes
# Le cluster 1 contient surtout la classe 2 et 3: 11 et 20
# Le cluster 2 contient surtout la classe 1 et 2: 20 et 9
# Donc l'assignation: cluster 1: classe 2 & 3, cluster 2: classe 20
# Accuracy: (11 + 20 + 20) / 60 = 85%
#Q10.e
# K-means cluster sur les onservations avec k=4
set.seed(8)
resultat <- kmeans(X, centers = 4)
label <- c(rep(1, 20), rep(2, 20), rep(3, 20))
comparaiton <- table(resultat$cluster, label)
print(comparaiton)
# Lignes: clusters du k-Means
# Colonnes: les étiquettes
# Le cluster 1 contient classe 2 et 3: 4 et 8
# Le cluster 2 contient classe 2 et 3: 5 et 4
# Le cluster 3 contient classe 2 et 3: 3 et 8
# Le cluster 4 contient classe 1 et 2: 20 et 8
# Donc l'assignation:
# cluster 1: classe 3 -> 8
# cluster 2: classe 2 -> 5
# cluster 3: classe 3 -> 8
# cluster 4: classe 1 -> 20
# Accuracy: (8 + 5 + 8 + 20) / 60 = 68.33%
#Q10.f
# k-means sur les 2 premier CP
PCA <- prcomp(X, scale = TRUE)
X_pca <- PCA$x[, 1:2]
set.seed(8)
resultat <- kmeans(X_pca, centers = 3)
label <- c(rep(1, 20), rep(2, 20), rep(3, 20))
comparaiton <- table(resultat$cluster, label)
print(comparaiton)
# Le cluster 1 contient la classe 1 et 2: 13 et 2
# Le cluster 2 contient la classe 1 et 2: 7 et 7
# Le cluster 3 contient la classe 2 et 3: 11 et 20
# Donc l'assignation:
#cluster 1: classe 1 -> 13
#cluster 2: classe 2 -> 7
#cluster 3: classe 3 -> 20
# Accuracy: (13 + 7 + 20) / 60 = 66.67%
# -> Amélioration de l'accuracy avec le PCA de +3.33%
# Q10.g
# Standardiser les données
X_scaled <- scale(X)
set.seed(8)
resultat <- kmeans(X_scaled, centers = 3)
label <- c(rep(1, 20), rep(2, 20), rep(3, 20))
comparaiton <- table(resultat$cluster, label)
print(comparaiton)
# Le cluster 1 contient la classe 1 et 2: 10 et 2
# Le cluster 2 contient la classe 1 et 2: 10 et 7
# Le cluster 3 contient la classe 2 et 3: 11 et 20
# Donc l'assignation:
#cluster 1: classe 1 -> 10
#cluster 2: classe 2 -> 7
#cluster 3: classe 3 -> 20
# Accuracy: (10 + 7 + 20) / 60 = 61.67%
# -> Dégradation de l'accuracy avec le scale de -1.67%
# La standardisation n’a pas permis d’améliorer le regroupement des observations.
# K-means est sensible à l’échelle des variables : si certaines variables ont une plus grande
# variance, elles influencent davantage le calcul des distances euclidiennes.
# Toutefois, la standardisation n’est pas toujours bénéfique.
# Mes résultats montrent que les variables initiales contenaient une structure informative
# que la standardisation a affaiblie, ce qui a légèrement réduit la qualité du clustering.
