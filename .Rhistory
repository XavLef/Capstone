# Normalisation ----
# Ne s'applique qu'on données numériques, ou faire du one-hot encoding sinon
X_oh <- model.matrix(medv ~ . , data = data) # ENLÈVE LA VARIABLE RÉPONSE
proportion_entrainement <- 0.8
set.seed(20240305)
taille_ech <- floor(proportion_entrainement * nrow(data))
idx_entrainement <- sample(1:nrow(data), size = taille_ech)
train <- data[idx_entrainement, ] # à voir si on garde la variable réponse ou pas
test <- data[-idx_entrainement, ]
str(train)
str(test)
# Train-test split ----
## NOTE: idéalement, on ferait ça avant l'analyse exploratoire. On explore juste
##       les données de train pour y aller vraiment à l'aveugle. On fait le même
##       prétraitement. Puis on ne fait que répéter avec test. Pour la normalisation,
##       il faut vraiment le faire comme ça pour éviter du leakage.
data <- Boston
X_min_train <- apply(X_oh, 2, min)
X_max_train <-  apply(X_oh, 2, min)
X_min_train
# Normalisation ----
# Ne s'applique qu'on données numériques, ou faire du one-hot encoding sinon
X_oh <- model.matrix(medv ~ . , data = data)[, -1] # ENLÈVE LA VARIABLE RÉPONSE
X_oh
X_min_train <- apply(X_oh, 2, min)
X_min_train
X_max_train <-  apply(X_oh, 2, max)
X_min_train <- apply(X_oh, 2, min)
X_max_train <-  apply(X_oh, 2, max)
train_uni <- apply(X_oh, 1, function(a) (a - X_min_train) / (X_max_train - X_min_train))
train_uni
train_uni <- t(apply(X_oh, 1, function(a) (a - X_min_train) / (X_max_train - X_min_train)))
train_uni
library(caret)
preProcess(X_oh, method = "range")
processor <- preProcess(X_oh, method = "range")
train_proc <- predict(processor, train)
train_proc
X_oh
