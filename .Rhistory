C_BF = C_BF + C_LR * (1 - betas[j])
C_BF_stock[i] = C_BF
}
}
# output
C_BF_stock
}
# # verification
max(compute_C_BF(C_LR, C_ij, dev_factor, j)) - C_ij
reserve_BF
compute_C_BF(C_LR, C_ij, dev_factor, j)
